# =====================================================================
#  COPIE ESTE ARQUIVO PARA ".env" E PREENCHA OS VALORES
#  (o .env NUNCA vai para o GitHub — ele já está no .gitignore)
# =====================================================================

PORT=3000
NODE_ENV=development

# 1) MONGODB (OBRIGATÓRIO) — use um banco NOVO, separado da barbearia
#    MongoDB Atlas > seu cluster > Connect > Drivers > copie a URI
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/loja_online?retryWrites=true&w=majority

# 2) SEGREDO DO LOGIN (OBRIGATÓRIO) — gere com: npm run gerar-chaves
JWT_SECRET=cole_aqui_o_valor_gerado

# 3) ENDEREÇOS
#    FRONTEND_URL: site das lojas (Netlify). Pode ter mais de um, separados por vírgula
#    API_URL: endereço desta API (Render). Usado no link das fotos
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000

# 4) LICENÇA (seu controle)
DIAS_TESTE=30
DIAS_PLANO=30
# Seu WhatsApp de suporte (aparece no painel do lojista). Só números com DDI
SUPORTE_WHATSAPP=5521999999999

# 5) E-MAIL — recuperar senha e avisos de pedido (resend.com, 3.000/mês grátis)
#    Sem chave, os e-mails só aparecem no terminal (não chegam a ninguém)
RESEND_API_KEY=
EMAIL_REMETENTE=Loja Online <onboarding@resend.dev>

# 6) FOTOS — opcional. Sem Cloudinary, as fotos ficam no próprio MongoDB
#    (ok para começar; com muitas lojas, configure o Cloudinary grátis)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 7) FRETE — cálculo da distância
#    GEOCODER: nominatim (grátis) | desligado (frete sempre "a combinar")
#    ROTAS: osrm (grátis) | ors (OpenRouteService, mais estável, chave grátis) | reta
GEOCODER=nominatim
ROTAS=osrm
ORS_API_KEY=
CONTATO_GEOCODER=seu@email.com
